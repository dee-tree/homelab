# journalctl -xeu backup-seafile-restic.service

[Unit]
Description=Generate a restic backup snapshot of seafile
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root
ExecStartPre=/usr/bin/docker stop seafile seafile-elasticsearch seafile-memcached seafile-mariadb
ExecStart=/usr/bin/restic backup ${SEAFILE_DATA_PATH}/conf ${SEAFILE_DATA_PATH}/seafile/conf ${SEAFILE_DATA_PATH}/seafile/seafile-data ${SEAFILE_DATA_PATH}/seafile/seahub-data ${SEAFILE_DATA_DB_PATH} --tag seafile
ExecStart=/usr/bin/restic forget --prune --keep-hourly ${BACKUP_RETENTION_HOURLY} --keep-daily ${BACKUP_RETENTION_DAILY} --keep-weekly ${BACKUP_RETENTION_WEEKLY} --keep-monthly ${BACKUP_RETENTION_MONTHLY} --keep-yearly ${BACKUP_RETENTION_YEARLY} --tag seafile
ExecStart=/usr/bin/restic check --read-data
ExecStartPost=/usr/bin/docker start seafile-mariadb seafile-memcached seafile-elasticsearch seafile

EnvironmentFile=/etc/restic/.restic.env
Environment=XDG_CACHE_HOME=/var/cache
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutSec=3600
Restart=no

[Install]
WantedBy=multi-user.target
