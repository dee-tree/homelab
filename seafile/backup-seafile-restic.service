# ln -s <this file> /etc/systemd/system/backup-seafile-restic.service
# sudo systemctl daemon-reload
# sudo systemctl enable --now backup-seafile-restic.timer
# sudo systemctl start backup-seafile-restic.service
# journalctl -xeu backup-seafile-restic.service

[Unit]
Description=Generate a restic backup snapshot of seafile
After=network.target
OnFailure=backup-restic-failure@%i.service

[Service]
Type=oneshot
WorkingDirectory=/root
ExecStartPre=/usr/bin/docker stop seafile seafile-seasearch seafile-redis seafile-mariadb
ExecStart=/usr/bin/restic backup ${SEAFILE_DATA_PATH}/conf ${SEAFILE_DATA_PATH}/seafile/conf ${SEAFILE_DATA_PATH}/seafile/seafile-data ${SEAFILE_DATA_PATH}/seafile/seahub-data ${SEAFILE_DATA_DB_PATH} --tag seafile
ExecStart=/usr/bin/restic forget --prune --keep-hourly ${BACKUP_RETENTION_HOURLY} --keep-daily ${BACKUP_RETENTION_DAILY} --keep-weekly ${BACKUP_RETENTION_WEEKLY} --keep-monthly ${BACKUP_RETENTION_MONTHLY} --keep-yearly ${BACKUP_RETENTION_YEARLY} --tag seafile
ExecStart=/usr/bin/restic check --read-data
ExecStartPost=/usr/bin/docker start seafile-mariadb seafile-redis seafile-seasearch seafile

EnvironmentFile=/etc/restic/.restic.env
Environment=XDG_CACHE_HOME=/var/cache
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutSec=3600
Restart=no

# Security hardening (see man 7 systemd.exec)
PrivateTmp=true
ProtectHome=yes
ProtectSystem=full
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectControlGroups=true
PrivateDevices=true
MemoryDenyWriteExecute=true
ReadWritePaths=/etc/restic

[Install]
WantedBy=multi-user.target
