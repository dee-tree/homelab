[Unit]
Description=Generate a restic backup snapshot of Linkwarden
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root
ExecStartPre=/usr/bin/docker stop linkwarden linkwarden-postgres
ExecStart=/usr/bin/restic backup ${LINKWARDEN_DATA_PATH} ${LINKWARDEN_DATA_DB_PATH} --tag linkwarden
ExecStart=/usr/bin/restic forget --prune --keep-hourly ${BACKUP_RETENTION_HOURLY} --keep-daily ${BACKUP_RETENTION_DAILY} --keep-weekly ${BACKUP_RETENTION_WEEKLY} --keep-monthly ${BACKUP_RETENTION_MONTHLY} --keep-yearly ${BACKUP_RETENTION_YEARLY} --tag linkwarden
ExecStart=/usr/bin/restic check --read-data
ExecStartPost=/usr/bin/docker start linkwarden-postgres linkwarden

EnvironmentFile=/etc/.restic.env
Environment=XDG_CACHE_HOME=/var/cache
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutSec=3600
Restart=no

[Install]
WantedBy=multi-user.target
