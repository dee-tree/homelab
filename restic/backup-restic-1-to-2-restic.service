# ln -s <this file> /etc/systemd/system/backup-restic-1-to-2-restic.service
# sudo systemctl daemon-reload
# sudo systemctl enable --now backup-restic-1-to-2-restic.timer
# sudo systemctl start backup-restic-1-to-2-restic.service
# journalctl -xeu backup-restic-1-to-2-restic.service

[Unit]
Description=Copy snapshots from restic server repo to "2" local repo
After=network.target
OnFailure=backup-restic-failure@%i.service

[Service]
Type=oneshot
WorkingDirectory=/root

ExecStart=/usr/bin/restic --repository-file $RESTIC_LOCAL_1_RPI_REPO_PATH --password-file $RESTIC_LOCAL_1_RPI_PASSWORD_PATH check --read-data
ExecStart=/usr/bin/restic --repository-file $RESTIC_LOCAL_1_LITH_REPO_PATH --password-file $RESTIC_LOCAL_1_LITH_PASSWORD_PATH check --read-data

ExecStart=/usr/bin/restic --from-repository-file $RESTIC_LOCAL_1_RPI_REPO_PATH --from-password-file $RESTIC_LOCAL_1_RPI_PASSWORD_PATH --repository-file $RESTIC_LOCAL_2_REPO_PATH --password-file $RESTIC_LOCAL_2_PASSWORD_PATH copy
ExecStart=/usr/bin/restic --from-repository-file $RESTIC_LOCAL_1_LITH_REPO_PATH --from-password-file $RESTIC_LOCAL_1_LITH_PASSWORD_PATH --repository-file $RESTIC_LOCAL_2_REPO_PATH --password-file $RESTIC_LOCAL_2_PASSWORD_PATH copy

ExecStart=/usr/bin/restic forget --repository-file $RESTIC_LOCAL_1_RPI_REPO_PATH --password-file $RESTIC_LOCAL_1_RPI_PASSWORD_PATH --prune --keep-hourly ${BACKUP_RETENTION_HOURLY} --keep-daily ${BACKUP_RETENTION_DAILY} --keep-weekly ${BACKUP_RETENTION_WEEKLY} --keep-monthly ${BACKUP_RETENTION_MONTHLY} --keep-yearly ${BACKUP_RETENTION_YEARLY}
ExecStart=/usr/bin/restic forget --repository-file $RESTIC_LOCAL_1_LITH_REPO_PATH --password-file $RESTIC_LOCAL_1_LITH_PASSWORD_PATH --prune --keep-hourly ${BACKUP_RETENTION_HOURLY} --keep-daily ${BACKUP_RETENTION_DAILY} --keep-weekly ${BACKUP_RETENTION_WEEKLY} --keep-monthly ${BACKUP_RETENTION_MONTHLY} --keep-yearly ${BACKUP_RETENTION_YEARLY}

EnvironmentFile=/etc/restic/.local2.restic.env
Environment=XDG_CACHE_HOME=/var/cache
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutSec=3600
Restart=no

# Security hardening (see man 7 systemd.exec)
PrivateTmp=true
ProtectHome=yes
ProtectSystem=full
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectControlGroups=true
PrivateDevices=true
MemoryDenyWriteExecute=true
ReadWritePaths=/etc/restic

[Install]
WantedBy=multi-user.target
