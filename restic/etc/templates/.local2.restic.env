RESTIC_LOCAL_1_RPI_REPO_PATH=/etc/restic/.local-1-rpi.repo.restic.env
RESTIC_LOCAL_1_LITH_REPO_PATH=/etc/restic/.local-1-lith.repo.restic.env
RESTIC_LOCAL_2_REPO_PATH=/etc/restic/.local-2.repo.restic.env

RESTIC_LOCAL_1_RPI_PASSWORD_PATH=/etc/restic/.local-1-rpi.password.restic.env
RESTIC_LOCAL_1_LITH_PASSWORD_PATH=/etc/restic/.local-1-lith.password.restic.env
RESTIC_LOCAL_2_PASSWORD_PATH=/etc/restic/.local-2.password.restic.env

RESTIC_COMPRESSION=auto

BACKUP_RETENTION_HOURLY=6
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_RETENTION_YEARLY=5