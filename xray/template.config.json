{
    "api": {
      "services": [
        "HandlerService",
        "LoggerService",
        "StatsService"
      ],
      "tag": "api"
    },
    "log": {
      "access": "/var/log/xray/access.log",
      "error": "/var/log/xray/error.log",
      "loglevel": "warning"
    },
    "inbounds": [
      {
        "port": "50101",
        "protocol": "vless",
        "settings": {
          "clients": [
            {
              // `vless://<UUID>@<server host>?security=reality&encryption=none&pbk=<public key>&headerType=none&fp=chrome&spx=%2F&type=tcp&flow=xtls-rprx-vision&sni=<SNI domain>&sid=<short ID>#connection`
              "email": "<client name>",
              "flow": "xtls-rprx-vision",
              "id": "<UUID>"
            }
          ],
          "decryption": "none",
          "fallbacks": [
          ]
        },
        "sniffing": {
            "enabled": true,
            "destOverride": [
                "http",
                "tls",
                "quic"
            ]
        },
        "streamSettings": {
            "network": "raw", // tcp
            "security": "reality",
            "realitySettings": {
                "dest": "SNI host",
                "privateKey": "<private key>", // public key: <>
                "maxTimeDiff": 86400000, // accept only connections with client time in range of 1 day precision (to avoid time difference attack)
                "serverNames": [
                  "<SNI host>"
                ],
                "shortIds": [
                  "<user short ID>"
                ],
                "show": false, // verbose logs
                "xver": 0
              },
              "rawSettings": { // tcp settings
                  "acceptProxyProtocol": false
              }
        },
        "tag": "reality"
      }
    ],
    "outbounds": [
      {
        "protocol": "freedom",
        "tag": "direct"
      },
      {
        "protocol": "blackhole",
        "tag": "blocked"
      }
    ],
    "policy": {
      "levels": {
        "0": {
          "handshake": 3, // The handshake time limit when the connection is established, in seconds, the default value is 4, it is recommended to be different from the default value
          "connIdle": 280, // Connection idle time limit in seconds, the default value is 300, it is recommended to be different from the default value
          "statsUserDownlink": true,
          "statsUserUplink": true
        }
      },
      "system": {
        "statsInboundDownlink": true,
        "statsInboundUplink": true,
        "statsOutboundDownlink": true,
        "statsOutboundUplink": true
      }
    }
  }

